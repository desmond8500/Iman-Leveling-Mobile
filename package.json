{
  "name": "iman-leveling-mobile",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Iman Leveling : suivi des pratiques religieuses sous forme de jeu mobile",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0f3a31' --splashBackgroundColor '#0f3a31'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@ionic/vue": "^8.5.0",
    "@ionic/vue-router": "^8.5.0",
    "ionicons": "^7.4.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
