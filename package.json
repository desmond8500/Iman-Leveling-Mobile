{
  "name": "iman-leveling-mobile",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Iman Leveling : suivi des pratiques religieuses sous forme de jeu mobile",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0f3a31' --splashBackgroundColor '#0f3a31'",
    "apk:debug": "npm run build && cap sync android && node scripts/gradle.mjs assembleDebug",
    "apk:release": "npm run build && cap sync android && node scripts/gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@ionic/vue": "^9.0.11",
    "@ionic/vue-router": "^9.0.11",
    "ionicons": "^8.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
